# Names only — never commit values. See docs/DEPLOYMENT.md for where each one goes.
# The committed .env holds only the public Supabase URL and publishable (anon) key.

# Browser (public, bundled into the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server (public values, read by server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server secrets
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Links in emails and invitations, e.g. https://portal.example.com (no trailing path)
APP_URL=

# Optional: transactional email via Resend (without these, email is logged as skipped)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
